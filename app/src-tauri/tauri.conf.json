{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PalaClips",
  "version": "1.1.0",
  "identifier": "com.palawi.palaclips",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost http://palaclips.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "licenseFile": "licenses/LICENSE-INSTALLER.txt",
    "resources": {
      "../../third_party/ffmpeg/bin/avcodec-62.dll": "avcodec-62.dll",
      "../../third_party/ffmpeg/bin/avdevice-62.dll": "avdevice-62.dll",
      "../../third_party/ffmpeg/bin/avfilter-11.dll": "avfilter-11.dll",
      "../../third_party/ffmpeg/bin/avformat-62.dll": "avformat-62.dll",
      "../../third_party/ffmpeg/bin/avutil-60.dll": "avutil-60.dll",
      "../../third_party/ffmpeg/bin/swresample-6.dll": "swresample-6.dll",
      "../../third_party/ffmpeg/bin/swscale-9.dll": "swscale-9.dll",
      "licenses/THIRD-PARTY.txt": "licenses/THIRD-PARTY.txt",
      "licenses/FFmpeg-LGPL-3.0.txt": "licenses/FFmpeg-LGPL-3.0.txt",
      "licenses/GPL-3.0.txt": "licenses/GPL-3.0.txt",
      "../../LICENSE": "licenses/PalaClips-MIT.txt"
    },
    "shortDescription": "Enregistrement et replay instantané, avec une piste audio par application",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "French": "nsis/French.nsh",
          "English": "nsis/English.nsh"
        }
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwRTA2RTIxNUJEQUI0NTYKUldSV3ROcGJJVzdnMEQ5Sm1aK1R2WXZMdUpCQUprTzMwZzVoWmVhNjZ1S0ZqMzE2K0NwdWt5RDIK",
      "endpoints": [
        "https://github.com/Palawizard/PalaClips/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
