  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one ink-filled action per area, shortcut inline.",
      "html": "<button class=\"ds-btn-primary\">Sauvegarder <span class=\"ds-kbd\">Alt+F10</span></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border:0;border-radius:6px;background:var(--ink,#e8ecf4);color:var(--ground,#0f1420);font:600 14px Barlow,'Segoe UI',sans-serif;cursor:pointer;transition:transform 140ms cubic-bezier(0.23,1,0.32,1),background-color 140ms ease,color 140ms ease}.ds-btn-primary:hover{background:color-mix(in srgb,var(--ink,#e8ecf4) 90%,transparent)}.ds-btn-primary:active{transform:scale(0.97)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus,#8fb8ff);outline-offset:2px}.ds-btn-primary:disabled{background:var(--surface-2,#1e2536);color:var(--ink-3,#7b869c);cursor:not-allowed}.ds-kbd{font:500 13px 'Barlow Condensed',Barlow,sans-serif;font-variant-numeric:tabular-nums lining-nums;opacity:.7}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined tonal action (Armer / Désarmer).",
      "html": "<button class=\"ds-btn-secondary\">Armer</button>",
      "css": ".ds-btn-secondary{height:36px;padding:0 14px;border:1px solid var(--line-strong,#343d52);border-radius:6px;background:transparent;color:var(--ink,#e8ecf4);font:500 14px Barlow,'Segoe UI',sans-serif;cursor:pointer;transition:transform 140ms cubic-bezier(0.23,1,0.32,1),background-color 140ms ease,color 140ms ease}.ds-btn-secondary:hover{background:var(--surface-hover,#232b3e)}.ds-btn-secondary:active{transform:scale(0.97)}.ds-btn-secondary:focus-visible{outline:2px solid var(--focus,#8fb8ff);outline-offset:2px}"
    },
    {
      "name": "Rail",
      "kind": "nav",
      "refersTo": "rail-item",
      "description": "Icon-over-label navigation in the 84px rail.",
      "html": "<nav class=\"ds-rail\"><button class=\"ds-rail-item\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m12 14 4-4\"/><path d=\"M3.34 19a10 10 0 1 1 17.32 0\"/></svg>État</button><button class=\"ds-rail-item\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"21\" x2=\"14\" y1=\"4\" y2=\"4\"/><line x1=\"10\" x2=\"3\" y1=\"4\" y2=\"4\"/><line x1=\"21\" x2=\"12\" y1=\"12\" y2=\"12\"/><line x1=\"8\" x2=\"3\" y1=\"12\" y2=\"12\"/><line x1=\"21\" x2=\"16\" y1=\"20\" y2=\"20\"/><line x1=\"12\" x2=\"3\" y1=\"20\" y2=\"20\"/><line x1=\"14\" x2=\"14\" y1=\"2\" y2=\"6\"/><line x1=\"8\" x2=\"8\" y1=\"10\" y2=\"14\"/><line x1=\"16\" x2=\"16\" y1=\"18\" y2=\"22\"/></svg>Réglages</button></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;align-items:center;gap:4px;width:84px;padding:16px 0;background:var(--rail,#0a0e17);border-right:1px solid var(--line,#262e40)}.ds-rail-item{display:flex;flex-direction:column;align-items:center;gap:4px;width:68px;padding:10px 0;border:0;border-radius:6px;background:transparent;color:var(--ink-3,#7b869c);font:500 12px Barlow,'Segoe UI',sans-serif;cursor:pointer;transition:transform 140ms cubic-bezier(0.23,1,0.32,1),background-color 140ms ease,color 140ms ease}.ds-rail-item:hover{background:var(--surface,#171d2b);color:var(--ink,#e8ecf4)}.ds-rail-item[aria-current=page]{background:var(--surface-2,#1e2536);color:var(--ink,#e8ecf4)}.ds-rail-item:active{transform:scale(0.97)}.ds-rail-item:focus-visible{outline:2px solid var(--focus,#8fb8ff);outline-offset:2px}"
    },
    {
      "name": "Roster Row",
      "kind": "custom",
      "refersTo": "jersey-plate",
      "description": "Signature: one audio track as a scoreboard row with jersey plate, meter and peak. Hover previews the save flash.",
      "html": "<div class=\"ds-row\" style=\"--row-color:#f2b84b\"><span class=\"ds-plate\">02</span><span class=\"ds-name\">Micro<small>Casque USB</small></span><span class=\"ds-meter\"><span class=\"ds-fill\"></span></span><span class=\"ds-peak\">−12,4 dB</span><span class=\"ds-state\">Capture</span></div>",
      "css": ".ds-row{display:grid;grid-template-columns:52px minmax(0,1.3fr) minmax(140px,2fr) 76px minmax(0,1fr);align-items:center;column-gap:16px;padding:12px 20px;border-bottom:1px solid var(--line,#262e40);color:var(--ink,#e8ecf4);font:400 14px/1.45 Barlow,'Segoe UI',sans-serif;transition:background-color 600ms cubic-bezier(0.23,1,0.32,1)}.ds-row:hover{background:color-mix(in srgb,var(--row-color) 16%,transparent);transition-duration:80ms}.ds-plate{display:flex;align-items:center;justify-content:center;width:44px;height:32px;border-radius:4px;background:var(--row-color);color:var(--ground,#0f1420);font:600 18px 'Barlow Condensed',Barlow,sans-serif;font-variant-numeric:tabular-nums lining-nums}.ds-name{font-weight:600}.ds-name small{display:block;font-weight:400;font-size:12px;color:var(--ink-3,#7b869c)}.ds-meter{position:relative;height:10px;border-radius:2px;overflow:hidden;background:var(--meter-ground,#0b0f18)}.ds-fill{position:absolute;inset:0;background:var(--row-color);transform-origin:left;transform:scaleX(.72)}.ds-peak{text-align:right;font:600 19px/1 'Barlow Condensed',Barlow,sans-serif;font-variant-numeric:tabular-nums lining-nums}.ds-state{font-size:13px;color:var(--ink-2,#a7b0c3)}"
    },
    {
      "name": "Clip Card",
      "kind": "card",
      "refersTo": "clip-card",
      "description": "Recap card for a saved clip with duration chip and jersey track dots.",
      "html": "<article class=\"ds-clip\"><div class=\"ds-thumb\"><span class=\"ds-dur\">00:30</span></div><div class=\"ds-body\"><p><b>Fortnite</b><small>il y a 2 min</small></p><ul><li style=\"background:#e8ecf4\"></li><li style=\"background:#f2b84b\"></li><li style=\"background:#4fc1b9\"></li><li style=\"background:#7fd18b\"></li></ul></div></article>",
      "css": ".ds-clip{width:280px;overflow:hidden;border:1px solid var(--line,#262e40);border-radius:6px;background:var(--surface,#171d2b);color:var(--ink,#e8ecf4);font:400 14px/1.45 Barlow,'Segoe UI',sans-serif}.ds-thumb{position:relative;aspect-ratio:16/9;background:var(--meter-ground,#0b0f18)}.ds-dur{position:absolute;right:6px;bottom:6px;padding:0 6px;border-radius:3px;background:color-mix(in srgb,var(--ground,#0f1420) 85%,transparent);font:600 14px 'Barlow Condensed',Barlow,sans-serif;font-variant-numeric:tabular-nums lining-nums}.ds-body{display:flex;flex-direction:column;gap:6px;padding:10px 12px}.ds-body p{display:flex;justify-content:space-between;align-items:baseline;margin:0}.ds-body small{font-size:12px;color:var(--ink-3,#7b869c)}.ds-body ul{display:flex;gap:4px;margin:0;padding:0;list-style:none}.ds-body li{width:20px;height:6px;border-radius:9999px}"
    },
    {
      "name": "Status Banner Cell",
      "kind": "custom",
      "refersTo": "status-banner",
      "description": "Banner cell led by its state, with the armed ring witness and the scoreboard clock.",
      "html": "<section class=\"ds-cell\"><h2><span class=\"ds-ring\"></span>Replay armé</h2><p><span class=\"ds-clock\">00:47</span><span class=\"ds-total\">/ 01:00</span> en mémoire</p></section>",
      "css": ".ds-cell{display:flex;flex-direction:column;gap:8px;padding:16px 20px;background:var(--surface,#171d2b);color:var(--ink-2,#a7b0c3);font:400 14px/1.45 Barlow,'Segoe UI',sans-serif}.ds-cell h2{display:flex;align-items:center;gap:10px;margin:0;color:var(--ink,#e8ecf4);font:600 15px Barlow,'Segoe UI',sans-serif}.ds-ring{width:12px;height:12px;box-sizing:border-box;border:2px solid var(--rec,#ff4d5e);border-radius:9999px}.ds-cell p{display:flex;align-items:baseline;gap:8px;margin:0}.ds-clock{color:var(--ink,#e8ecf4);font:600 40px/1 'Barlow Condensed',Barlow,sans-serif;font-variant-numeric:tabular-nums lining-nums;letter-spacing:.01em}.ds-total{color:var(--ink-3,#7b869c);font:500 20px/1 'Barlow Condensed',Barlow,sans-serif;font-variant-numeric:tabular-nums lining-nums}"
    }
  ],
  "narrative": {
    "northStar": "The After-Match Scoreboard",
    "overview": "Every audio track is a player on the team, lined up in a roster like the scoreboard a competitive shooter shows at the end of a round. The window is read at a glance, then closed: it states whether the replay is armed, how many seconds are held, what that costs, and which tracks will land in the clip. Density is high but calm; figures are large, condensed and tabular, prose is short and in the second person.\n\nThe world is stadium night: a blue-black ground with flat tonal surfaces, a single ink, hairline rules that cut the window into whole cells, and one fixed jersey colour per track that never changes meaning. It deliberately refuses the category's default of dark cards with one neon accent; colour carries identity (which track) or one state (it records), never decoration. Native Windows 11 in spirit: restrained, gently rounded, quiet motion, offline fonts.",
    "keyCharacteristics": [
      "Recomposition by whole cells on a strict grid, separated by 1 px rules, no floating cards on the home screen.",
      "Scoreboard figures in Barlow Condensed with tabular lining numerals; text in Barlow.",
      "One fixed colour per audio track, shown as a jersey number plate and repeated as dots wherever that track appears.",
      "Red is a single word: \"it records\".",
      "Dark by default with a full light theme derived from the same roles."
    ],
    "rules": [
      {
        "name": "The One Meaning Red Rule",
        "body": "Red says \"it records\" and nothing else. Outlined ring = replay armed; solid red = manual recording in progress. Brand marks, errors and emphasis never borrow it; the rail mark is drawn in ink.",
        "section": "colors"
      },
      {
        "name": "The Fixed Jersey Rule",
        "body": "A track's colour is assigned once (Mix ink, Micro amber, Jeu green, apps track-1..11 in config order, unknown titles hashed) and never reassigned or reused for anything else. The same colour follows the track to every screen: roster, clip cards, audio sources, player, toast.",
        "section": "colors"
      },
      {
        "name": "The Ink Is The Accent Rule",
        "body": "No interface accent colour exists. The primary action is an ink fill; everything else is tonal.",
        "section": "colors"
      },
      {
        "name": "The Figures Are Condensed Rule",
        "body": "Any number the user reads at a glance (time, size, dB, track number, shortcut) is set in Barlow Condensed with tabular lining numerals. Body copy never uses the condensed face.",
        "section": "typography"
      },
      {
        "name": "The State Is The Heading Rule",
        "body": "A banner cell is introduced by its current state (\"Replay armé\", \"Enregistrement arrêté\", the source name, the free space), never by an uppercase category label. Uppercase labels exist only as table column headers.",
        "section": "typography"
      },
      {
        "name": "The Whole Cell Rule",
        "body": "Content recomposes by whole cells on the grid, divided by 1 px line rules. Cells do not float, overlap or carry their own shadows.",
        "section": "layout"
      },
      {
        "name": "The Flat Scoreboard Rule",
        "body": "If a surface needs to stand apart, step its tone or rule it off; do not add a shadow.",
        "section": "elevation"
      },
      {
        "name": "The Jersey Plate Rule",
        "body": "A track's colour is carried by its numbered plate (and its icon and meter), never by a coloured stripe on the row edge.",
        "section": "components"
      }
    ],
    "dos": [
      "Do set every glanceable figure in Barlow Condensed with tabular lining numerals.",
      "Do give each audio track its fixed jersey colour and repeat it wherever that track appears.",
      "Do lead banner cells with their current state as the heading.",
      "Do divide the window into whole cells with 1 px line rules on a 20 px inset.",
      "Do keep the primary action an ink fill and everything else tonal.",
      "Do drop every transition to 0 ms under `prefers-reduced-motion`."
    ],
    "donts": [
      "Don't use red for anything except recording: not for errors, brand marks or emphasis. Armed replay is an outlined ring; solid red is recording in progress only.",
      "Don't reassign or reuse a track colour for another track or for interface chrome.",
      "Don't mark tracks with a coloured stripe on the row edge; use the jersey plate.",
      "Don't put uppercase eyebrow labels above banner cells or sections; uppercase labels are for table column headers only.",
      "Don't add shadows or neon accents; depth is tonal and flat.",
      "Don't load fonts or icons from the network, or mix icon families."
    ]
  }
}
